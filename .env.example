# 복사해서 .env 로 쓴다 (git 에 올리지 않음). DESIGN §2.4
# 로컬 개발(infra/compose.dev.yaml)은 이 파일 없이도 기본값으로 뜬다. 값을 바꿀 때만:
#   docker compose --env-file .env -f infra/compose.dev.yaml up
# 운영(infra/compose.yaml)은 아래 값이 모두 필요하다.

# Caddy 사이트 주소 · MediaMTX WebRTC 공개 호스트. 로컬은 localhost(Caddy 내부 CA), 운영은 도메인
PUBLIC_HOST=localhost
# MediaMTX 훅이 backend 를 부를 때 쓰는 토큰 (운영에서는 반드시 바꾼다)
INTERNAL_TOKEN=change-me

# MySQL (compose 가 같은 값으로 DB 를 만든다)
MYSQL_ROOT_PASSWORD=root
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/livestream?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=livestream
SPRING_DATASOURCE_PASSWORD=livestream

JWT_SECRET=32바이트_이상_임의_문자열

# 토스페이먼츠 테스트 키 (DON-1 전까지 비워 둬도 된다)
APP_TOSS_CLIENT_KEY=test_ck_...
APP_TOSS_SECRET_KEY=test_sk_...

APP_GRID_THRESHOLD=100
APP_SEED_ENABLED=false
APP_RECORDING_RETENTION_DAYS=30
